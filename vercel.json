{
  "rewrites": [
    {
      "source": "/injuries",
      "destination": "https://naismith-api-production.up.railway.app/public/site/injuries"
    },
    {
      "source": "/players",
      "destination": "https://naismith-api-production.up.railway.app/public/site/players"
    },
    {
      "source": "/players/:slug",
      "destination": "https://naismith-api-production.up.railway.app/public/site/players/:slug"
    },
    {
      "source": "/sitemap-players.xml",
      "destination": "https://naismith-api-production.up.railway.app/public/site/sitemap.xml"
    },
    {
      "source": "/mcp",
      "destination": "https://naismith-api-production.up.railway.app/mcp"
    },
    {
      "source": "/mcp/v1",
      "destination": "https://naismith-api-production.up.railway.app/mcp/v1"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/openai-apps-challenge",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
